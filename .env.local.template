# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Custom Auth Domain (if using custom domain for OAuth)
# VITE_SUPABASE_AUTH_DOMAIN=https://auth.tuneatlife.com

# Sentry Configuration (existing)
VITE_SENTRY_DSN=your-sentry-dsn
VITE_SENTRY_ORG=tuneatlife
VITE_SENTRY_PROJECT=tuneatlife-portal

# Cloudinary Configuration (existing)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key
VITE_CLOUDINARY_API_SECRET=your-api-secret